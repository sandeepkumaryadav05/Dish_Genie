# Firebase config (from Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API base URL
# Development:  VITE_API_URL=http://localhost:4000
# Production:   VITE_API_URL=https://your-app.onrender.com
VITE_API_URL=http://localhost:4000
