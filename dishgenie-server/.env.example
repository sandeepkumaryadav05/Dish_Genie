# Environment
NODE_ENV=development

# Port the API listens on (Render provides this automatically)
PORT=4000

# MongoDB connection string (Atlas or local)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dishgenie

# Comma-separated list of allowed browser origins for CORS
# Development:
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (add your Vercel domain):
# ALLOW_ORIGINS=https://your-app.vercel.app

# Seed guard key — required to run `npm run seed`
SEED_KEY=change_me

# Firebase project id used to verify Firebase ID tokens on protected endpoints.
# Only the project id is needed — no service-account file required for verification.
FIREBASE_PROJECT_ID=your_firebase_project_id

# Optional: AI provider configuration (Google Gemini API).
# Leave AI_API_KEY empty to run the assistant in offline database-only mode.
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
